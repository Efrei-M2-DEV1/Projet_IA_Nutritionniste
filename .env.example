# Variables optionnelles lues par docker compose.
# Copier en .env a la racine si vous voulez activer un provider LLM.

# Laisser vide pour utiliser le fallback local par table nutritionnelle.
LLM_PROVIDER=

# Mistral
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Hugging Face, utile seulement pour un modele prive ou soumis a authentification.
HF_TOKEN=
