# Variables d'environnement — copier en .env et remplir les valeurs

# ── LLM nutrition (Personne 3 — nutrition.py) ────────────────────────────────
# Provider : mistral | openai | (vide = auto-détection via clés API, sinon fallback table)
LLM_PROVIDER=

MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Hugging Face (optionnel pour les modèles privés)
# HF_TOKEN=

# ── Serveur ───────────────────────────────────────────────────────────────────
# Origines CORS autorisées (séparées par des virgules)
ALLOWED_ORIGINS=http://localhost:5173,https://localhost:5173,http://localhost:3000
